          ['nav_home','#beranda'],
          ['nav_video','#video'],
          ['nav_process','#proses'],
          ['nav_contact','#kontak'],
        ].map(([key, href]) => (
          <a href={href} data-i18n={key} class="relative group text-gray-300 hover:text-white text-sm font-medium transition-colors duration-200">
