---
const products = [
  {
    title: 'Pintu Utama',
    desc: 'Pintu depan kayu jati solid dengan finishing premium, tampil megah dan elegan.',
    image: 'https://images.unsplash.com/photo-1586023492125-27b2c045efd7?w=600&q=80',
  },
  {
    title: 'Pintu Kamar',
    desc: 'Pintu kamar minimalis dari kayu jati pilihan, ringan namun tetap kokoh dan tahan lama.',
    image: 'https://images.unsplash.com/photo-1558618666-fcd25c85cd64?w=600&q=80',
  },
  {
    title: 'Pintu Panel',
    desc: 'Pintu panel motif klasik maupun modern, tersedia berbagai pilihan finishing cat & politur.',
    image: 'https://images.unsplash.com/photo-1600585154340-be6161a56a0c?w=600&q=80',
  },
  {
    title: 'Pintu Custom',
    desc: 'Desain dan ukuran sesuai permintaan. Wujudkan pintu impian Anda bersama kami.',
    image: 'https://images.unsplash.com/photo-1504148455328-c376907d081c?w=600&q=80',
  },
]
---

<section id="produk" class="py-24 bg-gray-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <span class="text-wood-500 text-xs font-bold uppercase tracking-[0.2em] mb-3 block">Produk Kami</span>
      <h2 class="text-4xl lg:text-5xl font-black text-gray-900 mb-4">Jenis Pintu Kami</h2>
      <p class="text-gray-500 text-lg max-w-xl mx-auto">
        Berbagai pilihan pintu kayu jati berkualitas untuk setiap kebutuhan hunian Anda.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {products.map(({ title, desc, image }) => (
        <div class="group bg-white rounded-2xl overflow-hidden shadow-md hover:shadow-xl transition-all duration-300 hover:-translate-y-2">
          <div class="relative h-52 overflow-hidden">
            <img
              src={image}
              alt={title}
              width="600"
              height="400"
              loading="lazy"
              class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500"
            />
          </div>
          <div class="p-6 text-center">
            <h3 class="text-gray-900 font-bold text-lg mb-2">{title}</h3>
            <p class="text-gray-500 text-sm leading-relaxed">{desc}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
