---
const advantages = [
  { title: 'Kayu Jati Asli', desc: 'Setiap pintu dibuat dari kayu jati asli pilihan — padat, kuat, dan indah secara alami.', color: 'bg-green-50 text-green-600', border: 'border-green-100' },
  { title: 'Pengrajin Berpengalaman', desc: 'Dikerjakan tangan oleh pengrajin berpengalaman yang teliti dalam setiap detail pintu.', color: 'bg-blue-50 text-blue-600', border: 'border-blue-100' },
  { title: 'Bergaransi', desc: 'Setiap pintu yang kami buat dilengkapi garansi. Kepuasan Anda adalah prioritas kami.', color: 'bg-wood-50 text-wood-600', border: 'border-wood-100' },
  { title: 'Konsultasi Gratis', desc: 'Konsultasikan kebutuhan pintu Anda secara gratis. Kami siap membantu dari awal hingga selesai.', color: 'bg-purple-50 text-purple-600', border: 'border-purple-100' },
]

const stats = [
  { value: '500+', label: 'Pintu Terpasang' },
  { value: '10+', label: 'Tahun Pengalaman' },
  { value: '98%', label: 'Pelanggan Puas' },
  { value: '24/7', label: 'Siap Konsultasi' },
]
---

<section id="tentang" class="py-24 bg-gray-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <span class="text-wood-500 text-xs font-bold uppercase tracking-[0.2em] mb-3 block">Mengapa Kami</span>
      <h2 class="text-4xl lg:text-5xl font-black text-gray-900 mb-4">Keunggulan Pintu Kami</h2>
      <p class="text-gray-500 text-lg max-w-xl mx-auto">
        Kami tidak sekadar membuat pintu — kami menghadirkan karya yang bertahan lama dan memperindah rumah Anda.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-16">
      {advantages.map(({ title, desc, color, border }) => (
        <div class={`bg-white rounded-2xl p-6 border ${border} shadow-sm hover:shadow-lg transition-all duration-300 hover:-translate-y-1 group`}>
          <div class={`w-12 h-12 rounded-xl ${color} flex items-center justify-center mb-4 group-hover:scale-110 transition-transform duration-300`}>
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
          </div>
          <h3 class="text-gray-900 font-bold text-lg mb-2">{title}</h3>
          <p class="text-gray-500 text-sm leading-relaxed">{desc}</p>
        </div>
      ))}
    </div>

    <div class="grid grid-cols-2 lg:grid-cols-4 gap-6">
      {stats.map(({ value, label }) => (
        <div class="bg-dark-800 rounded-2xl p-6 text-center">
          <div class="text-wood-400 text-4xl font-black mb-1">{value}</div>
          <div class="text-gray-400 text-sm font-medium">{label}</div>
        </div>
      ))}
    </div>
  </div>
</section>
