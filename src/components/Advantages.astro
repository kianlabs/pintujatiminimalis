---
const advantages = [
  { title: 'Jati Perhutani Asli', desc: 'Menggunakan kayu jati asli Perhutani bersertifikat — legal, padat, dan tahan puluhan tahun.', icon: 'M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z' },
  { title: 'Pengrajin Berpengalaman', desc: 'Dikerjakan tangan oleh pengrajin berpengalaman yang teliti dalam setiap detail pintu.', icon: 'M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0' },
  { title: 'Bergaransi', desc: 'Setiap pintu yang kami buat dilengkapi garansi. Kepuasan Anda adalah prioritas kami.', icon: 'M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z' },
  { title: 'Konsultasi Gratis', desc: 'Konsultasikan kebutuhan pintu Anda secara gratis. Kami siap membantu dari awal hingga selesai.', icon: 'M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z' },
]

const stats = [
  { value: '500+', label: 'Pintu Terpasang' },
  { value: '10+', label: 'Tahun Pengalaman' },
  { value: '98%', label: 'Pelanggan Puas' },
  { value: '24/7', label: 'Siap Konsultasi' },
]
---

<section id="tentang" class="py-24 bg-surface-800">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div id="adv-heading" class="text-center mb-16">
      <span class="text-primary-400 text-xs font-bold uppercase tracking-[0.2em] mb-3 block">Mengapa Kami</span>
      <h2 class="text-4xl lg:text-5xl font-black text-white mb-4">Keunggulan Pintu Jati Perhutani</h2>
      <p class="text-gray-400 text-lg max-w-xl mx-auto">
        Kami tidak sekadar membuat pintu — kami menghadirkan pintu jati Perhutani asli yang bertahan lama dan memperindah rumah Anda.
      </p>
    </div>

    <div id="adv-cards" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-16">
      {advantages.map(({ title, desc, icon }) => (
        <div class="bg-surface-700 rounded-2xl p-6 border border-surface-600 hover:border-primary-500 transition-all duration-300 hover:-translate-y-1 group">
          <div class="w-12 h-12 rounded-xl bg-primary-500/20 flex items-center justify-center mb-4 group-hover:bg-primary-500/30 transition-colors duration-300">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-primary-400"><path d={icon}/></svg>
          </div>
          <h3 class="text-white font-bold text-lg mb-2">{title}</h3>
          <p class="text-gray-400 text-sm leading-relaxed">{desc}</p>
        </div>
      ))}
    </div>

    <div id="adv-stats" class="grid grid-cols-2 lg:grid-cols-4 gap-6">
      {stats.map(({ value, label }) => (
        <div class="bg-surface-900 rounded-2xl p-6 text-center border border-surface-600">
          <div class="text-primary-400 text-4xl font-black mb-1">{value}</div>
          <div class="text-gray-400 text-sm font-medium">{label}</div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap'
  import { ScrollTrigger } from 'gsap/ScrollTrigger'
  gsap.registerPlugin(ScrollTrigger)
  gsap.fromTo('#adv-heading', { opacity: 0, y: 40 }, { opacity: 1, y: 0, duration: 0.8, ease: 'power3.out', scrollTrigger: { trigger: '#adv-heading', start: 'top 85%' } })
  gsap.fromTo('#adv-cards > *', { opacity: 0, y: 40 }, { opacity: 1, y: 0, duration: 0.7, stagger: 0.15, ease: 'power3.out', scrollTrigger: { trigger: '#adv-cards', start: 'top 80%' } })
  gsap.fromTo('#adv-stats > *', { opacity: 0, y: 30, scale: 0.9 }, { opacity: 1, y: 0, scale: 1, duration: 0.6, stagger: 0.1, ease: 'back.out(1.4)', scrollTrigger: { trigger: '#adv-stats', start: 'top 85%' } })
</script>
