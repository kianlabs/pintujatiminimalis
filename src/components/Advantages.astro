---
import { translations } from '../i18n/translations'
import type { Lang } from '../i18n/translations'
const { lang = 'id' } = Astro.props
const t = translations[lang]
const advantages = [
  { titleKey: 'adv_1_title', descKey: 'adv_1_desc', icon: 'M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z' },
  { titleKey: 'adv_2_title', descKey: 'adv_2_desc', icon: 'M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0' },
  { titleKey: 'adv_3_title', descKey: 'adv_3_desc', icon: 'M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z' },
  { titleKey: 'adv_4_title', descKey: 'adv_4_desc', icon: 'M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z' },
]
const stats = [
  { value: '500+', labelKey: 'stat_1' },
  { value: '20+', labelKey: 'stat_2' },
  { value: '98%',  labelKey: 'stat_3' },
  { value: '24/7', labelKey: 'stat_4' },
]
---

<section id="tentang" class="py-12 sm:py-24 bg-surface-800">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div id="adv-heading" class="text-center mb-16">
      <span data-i18n="adv_label" class="text-primary-400 text-xs font-bold uppercase tracking-[0.2em] mb-3 block">{t.adv_label}</span>
      <h2 data-i18n="adv_title" class="text-4xl lg:text-5xl font-black text-white mb-4">{t.adv_title}</h2>
      <p data-i18n="adv_desc" class="text-gray-400 text-lg max-w-xl mx-auto">
        {t.adv_desc}
      </p>
    </div>

    <div id="adv-cards" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-16">
      {advantages.map(({ titleKey, descKey, icon }) => (
        <div class="bg-surface-700 rounded-2xl p-6 border border-surface-600 hover:border-primary-500 transition-all duration-300 hover:-translate-y-1 group">
          <div class="w-12 h-12 rounded-xl bg-primary-500/20 flex items-center justify-center mb-4 group-hover:bg-primary-500/30 transition-colors duration-300">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-primary-400"><path d={icon}/></svg>
          </div>
          <h3 data-i18n={titleKey} class="text-white font-bold text-lg mb-2">{t[titleKey as keyof typeof t]}</h3>
          <p data-i18n={descKey} class="text-gray-400 text-sm leading-relaxed">{t[descKey as keyof typeof t]}</p>
        </div>
      ))}
    </div>

    <div id="adv-stats" class="grid grid-cols-2 lg:grid-cols-4 gap-6">
      {stats.map(({ value, labelKey }) => (
        <div class="bg-surface-900 rounded-2xl p-6 text-center border border-surface-600">
          <div class="text-primary-400 text-4xl font-black mb-1">{value}</div>
          <div data-i18n={labelKey} class="text-gray-400 text-sm font-medium">{t[labelKey as keyof typeof t]}</div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap'
  import { ScrollTrigger } from 'gsap/ScrollTrigger'
  gsap.registerPlugin(ScrollTrigger)
  gsap.fromTo('#adv-heading', { opacity: 0, y: 40 }, { opacity: 1, y: 0, duration: 0.8, ease: 'power3.out', scrollTrigger: { trigger: '#adv-heading', start: 'top 85%' } })
  gsap.fromTo('#adv-cards > *', { opacity: 0, y: 40 }, { opacity: 1, y: 0, duration: 0.7, stagger: 0.15, ease: 'power3.out', scrollTrigger: { trigger: '#adv-cards', start: 'top 80%' } })
  gsap.fromTo('#adv-stats > *', { opacity: 0, y: 30, scale: 0.9 }, { opacity: 1, y: 0, scale: 1, duration: 0.6, stagger: 0.1, ease: 'back.out(1.4)', scrollTrigger: { trigger: '#adv-stats', start: 'top 85%' } })
</script>
