---
---

<section id="beranda" class="relative min-h-screen flex items-center justify-center overflow-hidden">
  <div
    class="absolute inset-0 bg-cover bg-center bg-no-repeat"
    style="background-image: url('https://images.unsplash.com/photo-1558618666-fcd25c85cd64?w=1920&q=90')"
  ></div>
  <div class="absolute inset-0" style="background: linear-gradient(to right, #0e151bf0, #0e151bcc, #0e151b99)"></div>
  <div class="absolute inset-0" style="background: linear-gradient(to top, #0e151bcc, transparent 60%)"></div>

  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-24 pb-20">
    <div class="max-w-3xl">
      <h1 id="hero-title" class="text-5xl sm:text-6xl lg:text-7xl font-black text-white leading-tight text-shadow-lg mb-6">
        <span data-i18n="hero_title_1">Pintu Jati Minimalis</span><br />
        <span class="text-primary-300" data-i18n="hero_title_2">Asli Jati Perhutani</span>
      </h1>

      <p id="hero-subtitle" data-i18n="hero_subtitle" class="text-gray-300 text-lg sm:text-xl leading-relaxed mb-8 max-w-xl text-shadow">
        Pintu Jati Minimalis menghadirkan pintu dari kayu jati asli Perhutani — bersertifikat, kokoh, dan tahan lama untuk hunian impian Anda.
      </p>

      <div id="hero-features" class="flex flex-wrap gap-2 sm:gap-4 mb-10">
        {[
          { titleKey: 'hero_pill_1_title', descKey: 'hero_pill_1_desc' },
          { titleKey: 'hero_pill_2_title', descKey: 'hero_pill_2_desc' },
          { titleKey: 'hero_pill_3_title', descKey: 'hero_pill_3_desc' },
        ].map(({ titleKey, descKey }) => (
          <div class="flex items-center gap-2 sm:gap-3 bg-white/10 backdrop-blur-sm border border-white/20 rounded-xl px-3 sm:px-4 py-2 sm:py-3">
            <div class="w-6 h-6 sm:w-8 sm:h-8 rounded-lg bg-primary-500/40 flex items-center justify-center flex-shrink-0">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="text-primary-300"><polyline points="20 6 9 17 4 12"/></svg>
            </div>
            <div>
              <div data-i18n={titleKey} class="text-white text-xs sm:text-sm font-semibold leading-none"></div>
              <div data-i18n={descKey} class="text-gray-400 text-xs mt-0.5 hidden sm:block"></div>
            </div>
          </div>
        ))}
      </div>

      <div id="hero-cta" class="flex flex-wrap gap-3">
        <a href="https://wa.me/6281548315366?text=Halo%2C%20saya%20ingin%20konsultasi%20mengenai%20pintu%20jati%20minimalis" target="_blank" rel="noreferrer"
          class="flex items-center gap-2 sm:gap-2.5 bg-green-wa hover:bg-green-wa-dark text-white font-bold px-5 sm:px-7 py-3 sm:py-4 rounded-full shadow-lg transition-all duration-300 hover:-translate-y-0.5 text-sm sm:text-base">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          <span data-i18n="hero_cta_dwi">Chat Dwi Toto</span>
        </a>
        <a href="https://wa.me/6285863413670?text=Halo%2C%20saya%20ingin%20konsultasi%20mengenai%20pintu%20jati%20minimalis" target="_blank" rel="noreferrer"
          class="flex items-center gap-2 sm:gap-2.5 bg-green-wa hover:bg-green-wa-dark text-white font-bold px-5 sm:px-7 py-3 sm:py-4 rounded-full shadow-lg transition-all duration-300 hover:-translate-y-0.5 text-sm sm:text-base">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          <span data-i18n="hero_cta_ferdi">Chat Ferdi</span>
        </a>
        <a href="#video"
          class="flex items-center gap-2 sm:gap-2.5 bg-white/10 hover:bg-white/20 backdrop-blur-sm border border-white/30 text-white font-semibold px-5 sm:px-7 py-3 sm:py-4 rounded-full transition-all duration-300 hover:-translate-y-0.5 text-sm sm:text-base">
          <span data-i18n="hero_cta_video">Lihat Video</span>
        </a>
      </div>
    </div>
  </div>

  <div id="scroll-indicator" class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 text-white/40">
    <span class="text-xs tracking-widest">Scroll</span>
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
  </div>
</section>

<script>
  import { gsap } from 'gsap'
  const tl = gsap.timeline({ delay: 0.3 })
  tl.fromTo('#hero-title', { opacity: 0, y: 40 }, { opacity: 1, y: 0, duration: 0.8, ease: 'power3.out' })
    .fromTo('#hero-subtitle', { opacity: 0, y: 30 }, { opacity: 1, y: 0, duration: 0.7, ease: 'power2.out' }, '-=0.4')
    .fromTo('#hero-features > *', { opacity: 0, y: 20 }, { opacity: 1, y: 0, duration: 0.5, stagger: 0.15, ease: 'power2.out' }, '-=0.3')
    .fromTo('#hero-cta > *', { opacity: 0, y: 20, scale: 0.95 }, { opacity: 1, y: 0, scale: 1, duration: 0.5, stagger: 0.1, ease: 'back.out(1.5)' }, '-=0.2')
  gsap.to('#scroll-indicator', { y: 10, repeat: -1, yoyo: true, duration: 1.2, ease: 'sine.inOut' })
</script>
