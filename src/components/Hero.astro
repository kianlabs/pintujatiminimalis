---
---

<section id="beranda" class="relative min-h-screen flex items-center justify-center overflow-hidden">
  <div
    class="absolute inset-0 bg-cover bg-center bg-no-repeat"
    style="background-image: url('https://images.unsplash.com/photo-1558618666-fcd25c85cd64?w=1600&q=80')"
  ></div>
  <div class="absolute inset-0 bg-gradient-to-r from-black/80 via-black/60 to-black/40"></div>
  <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent"></div>

  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-24 pb-20">
    <div class="max-w-3xl">
      <!-- Badge -->
      <div class="inline-flex items-center gap-2 bg-wood-500/20 border border-wood-400/40 text-wood-300 text-xs font-semibold tracking-widest px-4 py-2 rounded-full mb-6">
        <div class="w-1.5 h-1.5 rounded-full bg-wood-400 animate-pulse"></div>
        Spesialis Pintu Kayu Jati
      </div>

      <!-- Title -->
      <h1 class="text-5xl sm:text-6xl lg:text-7xl font-black text-white leading-tight text-shadow-lg mb-6">
        Pintu Kayu Jati<br />
        <span class="text-wood-400">Minimalis & Elegan</span>
      </h1>

      <!-- Subtitle -->
      <p class="text-gray-300 text-lg sm:text-xl leading-relaxed mb-8 max-w-xl text-shadow">
        Pintu Jati Minimalis menghadirkan pintu kayu jati berkualitas tinggi —
        tampilan elegan, kokoh, dan tahan lama untuk hunian impian Anda.
      </p>

      <!-- Feature Pills -->
      <div class="flex flex-wrap gap-4 mb-10">
        {[
          { title: 'Kayu Jati Pilihan', desc: 'Kualitas terbaik, tahan lama' },
          { title: 'Presisi & Rapi', desc: 'Detail finishing sempurna' },
          { title: 'Kuat & Kokoh', desc: 'Bertahan puluhan tahun' },
        ].map(({ title, desc }) => (
          <div class="flex items-center gap-3 bg-white/10 backdrop-blur-sm border border-white/20 rounded-xl px-4 py-3">
            <div class="w-8 h-8 rounded-lg bg-wood-500/40 flex items-center justify-center flex-shrink-0">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="text-wood-300"><polyline points="20 6 9 17 4 12"/></svg>
            </div>
            <div>
              <div class="text-white text-sm font-semibold leading-none">{title}</div>
              <div class="text-gray-400 text-xs mt-0.5">{desc}</div>
            </div>
          </div>
        ))}
      </div>

      <!-- CTA -->
      <div class="flex flex-wrap gap-4">
        <a
          href="https://wa.me/6281318679190"
          target="_blank"
          rel="noreferrer"
          class="flex items-center gap-2.5 bg-green-wa hover:bg-green-wa-dark text-white font-bold px-7 py-4 rounded-full shadow-lg transition-all duration-300 hover:-translate-y-0.5"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          Pesan Pintu Sekarang
        </a>
        <a
          href="#galeri"
          class="flex items-center gap-2.5 bg-white/10 hover:bg-white/20 backdrop-blur-sm border border-white/30 text-white font-semibold px-7 py-4 rounded-full transition-all duration-300 hover:-translate-y-0.5"
        >
          Lihat Galeri
        </a>
      </div>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 text-white/50 animate-bounce">
    <span class="text-xs tracking-widest">Scroll</span>
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
  </div>
</section>
