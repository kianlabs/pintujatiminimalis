---
import { translations } from '../i18n/translations'
import type { Lang } from '../i18n/translations'
const { lang = 'id' } = Astro.props
const t = translations[lang]
const steps = [
  { step: '01', titleKey: 'process_1_title', descKey: 'process_1_desc' },
  { step: '02', titleKey: 'process_2_title', descKey: 'process_2_desc' },
  { step: '03', titleKey: 'process_3_title', descKey: 'process_3_desc' },
  { step: '04', titleKey: 'process_4_title', descKey: 'process_4_desc' },
]
---

<section id="proses" class="py-12 sm:py-24 bg-surface-900 overflow-hidden relative">
  <div class="absolute inset-0 opacity-10 pointer-events-none">
    <div class="absolute top-0 left-0 w-96 h-96 bg-primary-500 rounded-full -translate-x-1/2 -translate-y-1/2 blur-3xl"></div>
    <div class="absolute bottom-0 right-0 w-96 h-96 bg-primary-500 rounded-full translate-x-1/2 translate-y-1/2 blur-3xl"></div>
  </div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 z-10">
    <div id="process-heading" class="text-center mb-20">
      <span data-i18n="process_label" class="text-primary-400 text-xs font-bold uppercase tracking-[0.2em] mb-3 block">{t.process_label}</span>
      <h2 data-i18n="process_title" class="text-4xl lg:text-5xl font-black text-white mb-4">{t.process_title}</h2>
      <p data-i18n="process_desc" class="text-gray-400 text-lg max-w-xl mx-auto">{t.process_desc}</p>
    </div>

    <div id="process-steps" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
      {steps.map(({ step, titleKey, descKey }) => (
        <div class="flex flex-col items-center text-center group">
          <div class="relative mb-6">
            <div class="w-28 h-28 rounded-full bg-surface-800 border-2 border-surface-600 flex flex-col items-center justify-center group-hover:border-primary-500 transition-colors duration-300">
              <span class="text-primary-400 text-2xl font-black">{step}</span>
            </div>
            <div class="absolute -top-1 -right-1 w-6 h-6 rounded-full bg-primary-500 text-white text-xs font-black flex items-center justify-center shadow-lg">
              {parseInt(step)}
            </div>
          </div>
          <h3 data-i18n={titleKey} class="text-white font-bold text-xl mb-3">{t[titleKey as keyof typeof t]}</h3>
          <p data-i18n={descKey} class="text-gray-400 text-sm leading-relaxed max-w-xs">{t[descKey as keyof typeof t]}</p>
        </div>
      ))}
    </div>

    <div class="text-center mt-16 flex flex-wrap justify-center gap-4">
      <a href="https://wa.me/6281548315366?text=Halo%2C%20saya%20ingin%20konsultasi%20mengenai%20pintu%20jati%20minimalis" target="_blank" rel="noreferrer"
        class="inline-flex items-center gap-2.5 bg-green-wa hover:bg-green-wa-dark text-white font-bold px-8 py-4 rounded-full shadow-lg transition-all duration-300 hover:-translate-y-0.5">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
        <span data-i18n="hero_cta_dwi">{t.hero_cta_dwi}</span>
      </a>
      <a href="https://wa.me/6285863413670?text=Halo%2C%20saya%20ingin%20konsultasi%20mengenai%20pintu%20jati%20minimalis" target="_blank" rel="noreferrer"
        class="inline-flex items-center gap-2.5 bg-green-wa hover:bg-green-wa-dark text-white font-bold px-8 py-4 rounded-full shadow-lg transition-all duration-300 hover:-translate-y-0.5">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
        <span data-i18n="hero_cta_ferdi">{t.hero_cta_ferdi}</span>
      </a>
    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap'
  import { ScrollTrigger } from 'gsap/ScrollTrigger'
  gsap.registerPlugin(ScrollTrigger)
  gsap.fromTo('#process-heading', { opacity: 0, y: 40 }, { opacity: 1, y: 0, duration: 0.8, ease: 'power3.out', scrollTrigger: { trigger: '#process-heading', start: 'top 85%' } })
  gsap.fromTo('#process-steps > *', { opacity: 0, y: 50 }, { opacity: 1, y: 0, duration: 0.7, stagger: 0.2, ease: 'power3.out', scrollTrigger: { trigger: '#process-steps', start: 'top 80%' } })
</script>
