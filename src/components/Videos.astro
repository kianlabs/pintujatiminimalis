---
import { Picture } from 'astro:assets'
import type { ImageMetadata } from 'astro'
import { translations } from '../i18n/translations'
import type { Lang } from '../i18n/translations'
const { lang = 'id' } = Astro.props
const t = translations[lang]
const videoThumbs = import.meta.glob('../assets/thumbnails/thumb_*.jpg', { eager: true, import: 'default' })
const videos = Array.from({ length: 30 }, (_, i) => {
  const n = String(i + 1).padStart(2, '0')
  return {
    src: `/videos/video_${n}.mp4`,
    thumb: videoThumbs[`../assets/thumbnails/thumb_${n}.jpg`] as ImageMetadata,
    label: `Video ${i + 1}`,
  }
})
---

<section id="video" class="py-12 sm:py-24 bg-surface-900">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Heading -->
    <div id="video-heading" class="text-center mb-12">
      <span data-i18n="video_label" class="text-primary-400 text-xs font-bold uppercase tracking-[0.2em] mb-3 block">{t.video_label}</span>
      <h2 data-i18n="video_title" class="text-4xl lg:text-5xl font-black text-white mb-4">{t.video_title}</h2>
      <p data-i18n="video_desc" class="text-gray-400 text-lg max-w-xl mx-auto">
        {t.video_desc}
      </p>
    </div>

    <!-- Video Grid -->
    <div id="video-grid" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-3 mb-6">
      {videos.map(({ src, thumb, label }, idx) => (
        <button
          class={`video-card group relative rounded-xl overflow-hidden aspect-[9/16] bg-surface-700 border border-surface-600 hover:border-primary-500 transition-all duration-300 hover:-translate-y-1 cursor-pointer${idx >= 10 ? ' hidden' : ''}`}
          data-src={src}
          data-idx={idx}
          aria-label={`Putar ${label}`}
        >
          <Picture src={thumb} alt={label} loading="lazy" formats={['avif', 'webp']}
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
          <div class="absolute inset-0 bg-surface-900/30 group-hover:bg-surface-900/10 transition-colors duration-300"></div>
          <div class="absolute inset-0 flex items-center justify-center">
            <div class="w-12 h-12 rounded-full bg-white/20 backdrop-blur-sm border border-white/40 flex items-center justify-center group-hover:bg-primary-500/80 group-hover:border-primary-400 transition-all duration-300">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="white" class="ml-1" aria-hidden="true"><polygon points="5 3 19 12 5 21 5 3"/></svg>
            </div>
          </div>
          <div class="absolute top-2 left-2 bg-surface-900/70 text-white text-xs font-bold px-2 py-0.5 rounded-md">
            {String(idx + 1).padStart(2, '0')}
          </div>
        </button>
      ))}
    </div>

    <!-- Tampilkan Lebih -->
    <div id="load-more-wrap" class="text-center mb-16">
      <button id="load-more-btn"
        class="inline-flex items-center gap-2 bg-surface-700 hover:bg-primary-500/20 border border-surface-600 hover:border-primary-500 text-gray-300 hover:text-white font-semibold px-8 py-3.5 rounded-full transition-all duration-200">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
        <span data-i18n="video_load_more">{t.video_load_more}</span>
      </button>
    </div>

    <!-- TikTok Embed -->
    <div class="border-t border-surface-700 pt-14">
      <div class="text-center mb-8">
        <span data-i18n="video_tiktok_label" class="text-primary-400 text-xs font-bold uppercase tracking-[0.2em] mb-3 block">{t.video_tiktok_label}</span>
        <h3 data-i18n="video_tiktok_title" class="text-2xl font-black text-white">{t.video_tiktok_title}</h3>
      </div>
      <div class="flex justify-center">
        <blockquote
          class="tiktok-embed"
          cite="https://www.tiktok.com/@ud.dwibarokahjati"
          data-unique-id="ud.dwibarokahjati"
          data-embed-type="creator"
          style="max-width: 780px; min-width: 288px; width: 100%;"
        >
          <section>
            <a target="_blank" href="https://www.tiktok.com/@ud.dwibarokahjati?refer=creator_embed">@ud.dwibarokahjati</a>
          </section>
        </blockquote>
      </div>
      <div class="text-center mt-8">
        <a href="https://www.tiktok.com/@ud.dwibarokahjati" target="_blank" rel="noreferrer"
          class="inline-flex items-center gap-2 bg-surface-700 hover:bg-primary-500/20 border border-surface-600 hover:border-primary-500 text-gray-300 hover:text-white font-semibold px-7 py-3.5 rounded-full transition-all duration-200">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-2.88 2.5 2.89 2.89 0 0 1-2.89-2.89 2.89 2.89 0 0 1 2.89-2.89c.28 0 .54.04.79.1V9.01a6.33 6.33 0 0 0-.79-.05 6.34 6.34 0 0 0-6.34 6.34 6.34 6.34 0 0 0 6.34 6.34 6.34 6.34 0 0 0 6.33-6.34V8.69a8.18 8.18 0 0 0 4.78 1.52V6.75a4.85 4.85 0 0 1-1.01-.06z"/></svg>
          <span data-i18n="video_tiktok_btn">{t.video_tiktok_btn}</span>
        </a>
      </div>
    </div>

  </div>
</section>

<!-- Modal Player -->
<div id="video-modal" class="fixed inset-0 z-[100] hidden items-center justify-center bg-black/95">
  <div class="relative w-full h-full flex items-center justify-center">
    <video
      id="modal-video"
      class="w-auto rounded-none bg-black"
      style="height: 92dvh; max-width: 100%; aspect-ratio: 9/16; object-fit: contain;"
      controls
      playsinline
      preload="metadata"
    ></video>
    <!-- Close -->
    <button id="modal-close"
      class="absolute top-2 right-2 flex items-center justify-center w-9 h-9 rounded-full bg-black/60 text-white z-10"
      aria-label="Tutup">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
    <!-- Prev -->
    <button id="modal-prev"
      class="absolute left-2 top-1/2 -translate-y-1/2 flex items-center justify-center w-9 h-9 rounded-full bg-black/60 text-white z-10"
      aria-label="Sebelumnya">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
    </button>
    <!-- Next -->
    <button id="modal-next"
      class="absolute right-2 top-1/2 -translate-y-1/2 flex items-center justify-center w-9 h-9 rounded-full bg-black/60 text-white z-10"
      aria-label="Berikutnya">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
    </button>
    <!-- Counter -->
    <div id="modal-counter" class="absolute top-2 left-2 text-white/60 text-xs font-medium bg-black/60 px-2 py-1 rounded-md z-10"></div>
  </div>
</div>

<script async src="https://www.tiktok.com/embed.js"></script>

<script>
  import { gsap } from 'gsap'
  import { ScrollTrigger } from 'gsap/ScrollTrigger'
  import { createVideoModal, initLoadMore } from '../scripts/videoModal'
  gsap.registerPlugin(ScrollTrigger)

  gsap.fromTo('#video-heading', { opacity: 0, y: 40 }, {
    opacity: 1, y: 0, duration: 0.8, ease: 'power3.out',
    scrollTrigger: { trigger: '#video-heading', start: 'top 85%' }
  })

  const visibleCards = Array.from(
    document.querySelectorAll<HTMLButtonElement>('.video-card')
  ).filter(c => !c.classList.contains('hidden'))

  gsap.fromTo(visibleCards, { opacity: 0, y: 30, scale: 0.95 }, {
    opacity: 1, y: 0, scale: 1, duration: 0.4, stagger: 0.04, ease: 'power2.out',
    scrollTrigger: { trigger: '#video-grid', start: 'top 85%' }
  })

  createVideoModal({
    cardSelector: '.video-card',
    modalId: 'video-modal',
    videoId: 'modal-video',
    closeId: 'modal-close',
    prevId: 'modal-prev',
    nextId: 'modal-next',
    counterId: 'modal-counter',
  })
  initLoadMore()
</script>
