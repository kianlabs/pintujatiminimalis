---
const videos = Array.from({ length: 30 }, (_, i) => ({
  src: `/videos/video_${String(i + 1).padStart(2, '0')}.mp4`,
  thumb: `/thumbnails/thumb_${String(i + 1).padStart(2, '0')}.jpg`,
  label: `Video ${i + 1}`,
}))
---

<section id="video" class="py-12 sm:py-24 bg-surface-900">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Heading -->
    <div id="video-heading" class="text-center mb-12">
      <span class="text-primary-400 text-xs font-bold uppercase tracking-[0.2em] mb-3 block">Video Kami</span>
      <h2 class="text-4xl lg:text-5xl font-black text-white mb-4">Lihat Proses & Hasil Kerja</h2>
      <p class="text-gray-400 text-lg max-w-xl mx-auto">
        Tonton video pembuatan dan pemasangan pintu jati Perhutani langsung dari workshop kami.
      </p>
    </div>

    <!-- Video Grid -->
    <div id="video-grid" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-3 mb-6">
      {videos.map(({ src, thumb, label }, idx) => (
        <button
          class={`video-card group relative rounded-xl overflow-hidden aspect-[9/16] bg-surface-700 border border-surface-600 hover:border-primary-500 transition-all duration-300 hover:-translate-y-1 cursor-pointer${idx >= 10 ? ' hidden' : ''}`}
          data-src={src}
          data-idx={idx}
          aria-label={`Putar ${label}`}
        >
          <img src={thumb} alt={label} loading="lazy"
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
          <div class="absolute inset-0 bg-surface-900/30 group-hover:bg-surface-900/10 transition-colors duration-300"></div>
          <div class="absolute inset-0 flex items-center justify-center">
            <div class="w-12 h-12 rounded-full bg-white/20 backdrop-blur-sm border border-white/40 flex items-center justify-center group-hover:bg-primary-500/80 group-hover:border-primary-400 transition-all duration-300">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="white" class="ml-1"><polygon points="5 3 19 12 5 21 5 3"/></svg>
            </div>
          </div>
          <div class="absolute top-2 left-2 bg-surface-900/70 text-white text-xs font-bold px-2 py-0.5 rounded-md">
            {String(idx + 1).padStart(2, '0')}
          </div>
        </button>
      ))}
    </div>

    <!-- Tampilkan Lebih -->
    <div id="load-more-wrap" class="text-center mb-16">
      <button id="load-more-btn"
        class="inline-flex items-center gap-2 bg-surface-700 hover:bg-primary-500/20 border border-surface-600 hover:border-primary-500 text-gray-300 hover:text-white font-semibold px-8 py-3.5 rounded-full transition-all duration-200">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
        Tampilkan Lebih
      </button>
    </div>

    <!-- TikTok Embed -->
    <div class="border-t border-surface-700 pt-14">
      <div class="text-center mb-8">
        <span class="text-primary-400 text-xs font-bold uppercase tracking-[0.2em] mb-3 block">TikTok Kami</span>
        <h3 class="text-2xl font-black text-white">Ikuti Kami di TikTok</h3>
      </div>
      <div class="flex justify-center">
        <blockquote
          class="tiktok-embed"
          cite="https://www.tiktok.com/@ud.dwibarokahjati"
          data-unique-id="ud.dwibarokahjati"
          data-embed-type="creator"
          style="max-width: 780px; min-width: 288px; width: 100%;"
        >
          <section>
            <a target="_blank" href="https://www.tiktok.com/@ud.dwibarokahjati?refer=creator_embed">@ud.dwibarokahjati</a>
          </section>
        </blockquote>
      </div>
      <div class="text-center mt-8">
        <a href="https://www.tiktok.com/@ud.dwibarokahjati" target="_blank" rel="noreferrer"
          class="inline-flex items-center gap-2 bg-surface-700 hover:bg-primary-500/20 border border-surface-600 hover:border-primary-500 text-gray-300 hover:text-white font-semibold px-7 py-3.5 rounded-full transition-all duration-200">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-2.88 2.5 2.89 2.89 0 0 1-2.89-2.89 2.89 2.89 0 0 1 2.89-2.89c.28 0 .54.04.79.1V9.01a6.33 6.33 0 0 0-.79-.05 6.34 6.34 0 0 0-6.34 6.34 6.34 6.34 0 0 0 6.34 6.34 6.34 6.34 0 0 0 6.33-6.34V8.69a8.18 8.18 0 0 0 4.78 1.52V6.75a4.85 4.85 0 0 1-1.01-.06z"/></svg>
          Lihat Semua Video di TikTok
        </a>
      </div>
    </div>

  </div>
</section>

<!-- Modal Player -->
<div id="video-modal" class="fixed inset-0 z-[100] hidden items-center justify-center bg-black/95">
  <div class="relative w-full h-full flex items-center justify-center">
    <video
      id="modal-video"
      class="h-full w-auto max-w-full rounded-none bg-black"
      style="max-height: 100vh; aspect-ratio: 9/16; object-fit: contain;"
      controls
      playsinline
      preload="metadata"
    ></video>
    <!-- Close — overlay pojok kanan atas -->
    <button id="modal-close"
      class="absolute top-2 right-2 flex items-center justify-center w-9 h-9 rounded-full bg-black/60 text-white z-10"
      aria-label="Tutup">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
    <!-- Prev — overlay kiri tengah -->
    <button id="modal-prev"
      class="absolute left-2 top-1/2 -translate-y-1/2 flex items-center justify-center w-9 h-9 rounded-full bg-black/60 text-white z-10"
      aria-label="Sebelumnya">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"/></svg>
    </button>
    <!-- Next — overlay kanan tengah -->
    <button id="modal-next"
      class="absolute right-2 top-1/2 -translate-y-1/2 flex items-center justify-center w-9 h-9 rounded-full bg-black/60 text-white z-10"
      aria-label="Berikutnya">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
    </button>
    <!-- Counter — pojok kiri atas -->
    <div id="modal-counter" class="absolute top-2 left-2 text-white/60 text-xs font-medium bg-black/60 px-2 py-1 rounded-md z-10"></div>
  </div>
</div>

<script async src="https://www.tiktok.com/embed.js"></script>

<script>
  import { gsap } from 'gsap'
  import { ScrollTrigger } from 'gsap/ScrollTrigger'
  gsap.registerPlugin(ScrollTrigger)

  gsap.fromTo('#video-heading', { opacity: 0, y: 40 }, {
    opacity: 1, y: 0, duration: 0.8, ease: 'power3.out',
    scrollTrigger: { trigger: '#video-heading', start: 'top 85%' }
  })
  gsap.fromTo('#video-grid > *', { opacity: 0, y: 30, scale: 0.95 }, {
    opacity: 1, y: 0, scale: 1, duration: 0.4, stagger: 0.04, ease: 'power2.out',
    scrollTrigger: { trigger: '#video-grid', start: 'top 85%' }
  })

  const modal = document.getElementById('video-modal')
  const modalVideo = document.getElementById('modal-video') as HTMLVideoElement
  const modalClose = document.getElementById('modal-close')
  const modalPrev = document.getElementById('modal-prev')
  const modalNext = document.getElementById('modal-next')
  const modalCounter = document.getElementById('modal-counter')
  const cards = document.querySelectorAll<HTMLButtonElement>('.video-card')
  let currentIdx = 0

  function openModal(idx: number) {
    currentIdx = idx
    const src = cards[idx].dataset.src || ''
    modalVideo!.src = src
    modalVideo!.load()
    modalVideo!.play()
    modalCounter!.textContent = `${idx + 1} / ${cards.length}`
    modal!.classList.remove('hidden')
    modal!.classList.add('flex')
    document.body.style.overflow = 'hidden'
  }

  function closeModal() {
    modalVideo!.pause()
    modalVideo!.src = ''
    modal!.classList.add('hidden')
    modal!.classList.remove('flex')
    document.body.style.overflow = ''
  }

  function navigate(dir: number) {
    const next = (currentIdx + dir + cards.length) % cards.length
    openModal(next)
  }

  // Load more
  const loadMoreBtn = document.getElementById('load-more-btn')
  const loadMoreWrap = document.getElementById('load-more-wrap')
  const hiddenCards = document.querySelectorAll<HTMLButtonElement>('.video-card.hidden')

  loadMoreBtn?.addEventListener('click', () => {
    hiddenCards.forEach((card, i) => {
      card.classList.remove('hidden')
      gsap.fromTo(card, { opacity: 0, y: 20 }, { opacity: 1, y: 0, duration: 0.4, delay: i * 0.03, ease: 'power2.out' })
    })
    loadMoreWrap?.remove()
  })

  cards.forEach((card, idx) => {
    card.addEventListener('click', () => openModal(idx))
  })

  modalClose?.addEventListener('click', closeModal)
  modalPrev?.addEventListener('click', () => navigate(-1))
  modalNext?.addEventListener('click', () => navigate(1))

  document.addEventListener('keydown', (e) => {
    if (!modal?.classList.contains('flex')) return
    if (e.key === 'Escape') closeModal()
    if (e.key === 'ArrowLeft') navigate(-1)
    if (e.key === 'ArrowRight') navigate(1)
  })
</script>
