---
const cncVideos = Array.from({ length: 4 }, (_, i) => ({
  src: `/videos/cnc/cnc_${String(i + 1).padStart(2, '0')}.mp4`,
  thumb: `/thumbnails/cnc/cnc_${String(i + 1).padStart(2, '0')}.jpg`,
  label: `Proses CNC ${i + 1}`,
}))
---

<section id="cnc" class="py-24 bg-surface-800">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <div id="cnc-heading" class="text-center mb-12">
      <span class="text-primary-400 text-xs font-bold uppercase tracking-[0.2em] mb-3 block">Teknologi Kami</span>
      <h2 class="text-4xl lg:text-5xl font-black text-white mb-4">
        Dibuat dengan <span class="text-primary-300">Mesin CNC</span>
      </h2>
      <p class="text-gray-400 text-lg max-w-2xl mx-auto">
        Pintu Jati Minimalis menggunakan mesin CNC (Computer Numerical Control) untuk mengukir setiap detail pintu kayu jati Perhutani dengan presisi dan konsistensi tinggi.
      </p>
    </div>

    <!-- 4 Video Proses CNC -->
    <div id="cnc-videos" class="grid grid-cols-2 sm:grid-cols-4 gap-3 sm:gap-4">
      {cncVideos.map(({ src, thumb, label }, idx) => (
        <button
          class="cnc-card group relative rounded-xl overflow-hidden aspect-[9/16] bg-surface-700 border border-primary-500/30 hover:border-primary-500 transition-all duration-300 hover:-translate-y-1 cursor-pointer"
          data-src={src}
          data-idx={idx}
          aria-label={`Putar ${label}`}
        >
          <img src={thumb} alt={label} loading="lazy"
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
          <div class="absolute inset-0 bg-surface-900/30 group-hover:bg-surface-900/10 transition-colors duration-300"></div>
          <div class="absolute inset-0 flex items-center justify-center">
            <div class="w-12 h-12 rounded-full bg-white/20 backdrop-blur-sm border border-white/40 flex items-center justify-center group-hover:bg-primary-500/80 group-hover:border-primary-400 transition-all duration-300">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="white" class="ml-1"><polygon points="5 3 19 12 5 21 5 3"/></svg>
            </div>
          </div>
          <div class="absolute top-2 left-2 bg-primary-500/80 text-white text-xs font-bold px-2 py-0.5 rounded-md">CNC</div>
        </button>
      ))}
    </div>

  </div>
</section>

<!-- Modal Player -->
<div id="cnc-modal" class="fixed inset-0 z-[100] hidden items-center justify-center bg-black/90 backdrop-blur-sm p-4">
  <div class="relative w-full max-w-sm mx-auto">
    <button id="cnc-modal-close" class="absolute -top-12 right-0 text-white/70 hover:text-white transition-colors z-10" aria-label="Tutup">
      <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
    <video id="cnc-modal-video" class="w-full rounded-2xl aspect-[9/16] bg-black object-contain" controls playsinline preload="metadata"></video>
    <div id="cnc-modal-counter" class="text-center text-white/50 text-sm mt-3"></div>
  </div>
</div>

<script>
  import { gsap } from 'gsap'
  import { ScrollTrigger } from 'gsap/ScrollTrigger'
  gsap.registerPlugin(ScrollTrigger)

  gsap.fromTo('#cnc-heading', { opacity: 0, y: 40 }, {
    opacity: 1, y: 0, duration: 0.8, ease: 'power3.out',
    scrollTrigger: { trigger: '#cnc-heading', start: 'top 85%' }
  })
  gsap.fromTo('#cnc-videos > *', { opacity: 0, y: 30, scale: 0.95 }, {
    opacity: 1, y: 0, scale: 1, duration: 0.5, stagger: 0.1, ease: 'power2.out',
    scrollTrigger: { trigger: '#cnc-videos', start: 'top 85%' }
  })

  const modal = document.getElementById('cnc-modal')
  const modalVideo = document.getElementById('cnc-modal-video') as HTMLVideoElement
  const modalClose = document.getElementById('cnc-modal-close')
  const modalCounter = document.getElementById('cnc-modal-counter')

  function openModal(src: string, idx: number) {
    modalVideo!.src = src
    modalVideo!.load()
    modalVideo!.play()
    modalCounter!.textContent = `CNC ${idx + 1} / 4`
    modal!.classList.remove('hidden')
    modal!.classList.add('flex')
    document.body.style.overflow = 'hidden'
  }

  function closeModal() {
    modalVideo!.pause()
    modalVideo!.src = ''
    modal!.classList.add('hidden')
    modal!.classList.remove('flex')
    document.body.style.overflow = ''
  }

  document.querySelectorAll<HTMLButtonElement>('.cnc-card').forEach((card, idx) => {
    card.addEventListener('click', () => openModal(card.dataset.src || '', idx))
  })

  modalClose?.addEventListener('click', closeModal)
  modal?.addEventListener('click', (e) => { if (e.target === modal) closeModal() })
  document.addEventListener('keydown', (e) => {
    if (modal?.classList.contains('flex') && e.key === 'Escape') closeModal()
  })
</script>
