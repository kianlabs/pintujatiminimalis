---
const printVideos = Array.from({ length: 4 }, (_, i) => ({
  src: `/videos/3dprinting/3dp_${String(i + 1).padStart(2, '0')}.mp4`,
  thumb: `/thumbnails/3dprinting/3dp_${String(i + 1).padStart(2, '0')}.jpg`,
  label: `Video 3D Printing ${i + 1}`,
}))
---

<section id="3dprinting" class="py-12 sm:py-24 bg-surface-900">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <div id="3dp-heading" class="text-center mb-12">
      <span data-i18n="tdp_label" class="text-primary-400 text-xs font-bold uppercase tracking-[0.2em] mb-3 block">Teknologi 3D</span>
      <h2 class="text-4xl lg:text-5xl font-black text-white mb-4">
        <span data-i18n="tdp_title_1">Dibuat dengan</span> <span class="text-primary-300" data-i18n="tdp_title_2">Teknologi 3D Printing</span>
      </h2>
      <p data-i18n="tdp_desc" class="text-gray-400 text-lg max-w-2xl mx-auto">
        Pintu Jati Minimalis menghadirkan inovasi desain menggunakan teknologi 3D printing untuk prototipe dan detail ornamen pintu yang presisi dan konsisten.
      </p>
    </div>

    <!-- 4 Video 3D Printing -->
    <div id="3dp-videos" class="grid grid-cols-2 sm:grid-cols-4 gap-3 sm:gap-4">
      {printVideos.map(({ src, thumb, label }, idx) => (
        <button
          class="tdp-card group relative rounded-xl overflow-hidden aspect-[9/16] bg-surface-700 border border-primary-500/30 hover:border-primary-500 transition-all duration-300 hover:-translate-y-1 cursor-pointer"
          data-src={src}
          data-idx={idx}
          aria-label={`Putar ${label}`}
        >
          <img src={thumb} alt={label} loading="lazy"
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
          <div class="absolute inset-0 bg-surface-900/30 group-hover:bg-surface-900/10 transition-colors duration-300"></div>
          <div class="absolute inset-0 flex items-center justify-center">
            <div class="w-12 h-12 rounded-full bg-white/20 backdrop-blur-sm border border-white/40 flex items-center justify-center group-hover:bg-primary-500/80 group-hover:border-primary-400 transition-all duration-300">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="white" class="ml-1" aria-hidden="true"><polygon points="5 3 19 12 5 21 5 3"/></svg>
            </div>
          </div>
          <div class="absolute top-2 left-2 bg-primary-500/80 text-white text-xs font-bold px-2 py-0.5 rounded-md">3D</div>
        </button>
      ))}
    </div>

  </div>
</section>

<!-- Modal Player -->
<div id="tdp-modal" class="fixed inset-0 z-[100] hidden items-center justify-center bg-black/95">
  <div class="relative w-full h-full flex items-center justify-center">
    <video id="tdp-modal-video"
      class="w-auto rounded-none bg-black"
      style="height: 92dvh; max-width: 100%; aspect-ratio: 9/16; object-fit: contain;"
      controls playsinline preload="metadata"></video>
    <button id="tdp-modal-close"
      class="absolute top-2 right-2 flex items-center justify-center w-9 h-9 rounded-full bg-black/60 text-white z-10"
      aria-label="Tutup">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
    <button id="tdp-modal-prev"
      class="absolute left-2 top-1/2 -translate-y-1/2 flex items-center justify-center w-9 h-9 rounded-full bg-black/60 text-white z-10"
      aria-label="Sebelumnya">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
    </button>
    <button id="tdp-modal-next"
      class="absolute right-2 top-1/2 -translate-y-1/2 flex items-center justify-center w-9 h-9 rounded-full bg-black/60 text-white z-10"
      aria-label="Berikutnya">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
    </button>
    <div id="tdp-modal-counter" class="absolute top-2 left-2 text-white/60 text-xs font-medium bg-black/60 px-2 py-1 rounded-md z-10"></div>
  </div>
</div>

<script>
  import { gsap } from 'gsap'
  import { ScrollTrigger } from 'gsap/ScrollTrigger'
  gsap.registerPlugin(ScrollTrigger)

  gsap.fromTo('#3dp-heading', { opacity: 0, y: 40 }, {
    opacity: 1, y: 0, duration: 0.8, ease: 'power3.out',
    scrollTrigger: { trigger: '#3dp-heading', start: 'top 85%' }
  })
  gsap.fromTo('#3dp-videos > *', { opacity: 0, y: 30, scale: 0.95 }, {
    opacity: 1, y: 0, scale: 1, duration: 0.5, stagger: 0.1, ease: 'power2.out',
    scrollTrigger: { trigger: '#3dp-videos', start: 'top 85%' }
  })

  const modal = document.getElementById('tdp-modal')
  const modalVideo = document.getElementById('tdp-modal-video') as HTMLVideoElement
  const modalClose = document.getElementById('tdp-modal-close')
  const modalPrev = document.getElementById('tdp-modal-prev')
  const modalNext = document.getElementById('tdp-modal-next')
  const modalCounter = document.getElementById('tdp-modal-counter')
  const cards = document.querySelectorAll<HTMLButtonElement>('.tdp-card')
  let currentIdx = 0

  function openModal(idx: number) {
    currentIdx = idx
    modalVideo!.src = cards[idx].dataset.src || ''
    modalVideo!.load()
    modalVideo!.play()
    modalCounter!.textContent = `3D ${idx + 1} / ${cards.length}`
    modal!.classList.remove('hidden')
    modal!.classList.add('flex')
    document.body.style.overflow = 'hidden'
  }

  function closeModal() {
    modalVideo!.pause()
    modalVideo!.src = ''
    modal!.classList.add('hidden')
    modal!.classList.remove('flex')
    document.body.style.overflow = ''
  }

  function navigate(dir: number) {
    const next = (currentIdx + dir + cards.length) % cards.length
    openModal(next)
  }

  cards.forEach((card, idx) => {
    card.addEventListener('click', () => openModal(idx))
  })

  modalClose?.addEventListener('click', closeModal)
  modalPrev?.addEventListener('click', () => navigate(-1))
  modalNext?.addEventListener('click', () => navigate(1))
  modal?.addEventListener('click', (e) => { if (e.target === modal) closeModal() })
  document.addEventListener('keydown', (e) => {
    if (modal?.classList.contains('flex') && e.key === 'Escape') closeModal()
  })
</script>
