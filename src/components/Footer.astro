---
const year = new Date().getFullYear()
const quickLinks = [
  { label: 'Beranda', href: '#beranda' },
  { label: 'Keunggulan', href: '#tentang' },
  { label: 'Produk', href: '#produk' },
  { label: 'Galeri', href: '#galeri' },
  { label: 'Cara Pesan', href: '#proses' },
  { label: 'Kontak', href: '#kontak' },
]
---

<footer class="bg-dark-900 text-gray-400">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-16 pb-8">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-12 mb-12">
      <div class="md:col-span-1">
        <div class="flex items-center gap-3 mb-4">
          <div class="w-10 h-10 rounded-lg bg-wood-500 flex items-center justify-center text-white font-black text-lg">P</div>
          <div>
            <div class="text-white font-bold text-lg leading-none">PINTU JATI MINIMALIS</div>
            <div class="text-wood-400 text-xs leading-none mt-0.5">Spesialis Pintu Kayu Jati</div>
          </div>
        </div>
        <p class="text-gray-500 text-sm leading-relaxed mb-6">
          Spesialis pembuatan pintu kayu jati berkualitas tinggi di Boyolali. Melayani dengan sepenuh hati untuk hunian impian Anda.
        </p>
        <a
          href="https://wa.me/6281318679190"
          target="_blank"
          rel="noreferrer"
          class="inline-flex items-center gap-2 bg-green-wa hover:bg-green-wa-dark text-white text-sm font-semibold px-5 py-2.5 rounded-full transition-colors duration-200"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          Pesan via WhatsApp
        </a>
      </div>

      <div>
        <h4 class="text-white font-bold text-sm tracking-widest mb-5 uppercase">Menu</h4>
        <ul class="space-y-3">
          {quickLinks.map(link => (
            <li><a href={link.href} class="text-gray-500 hover:text-wood-400 text-sm transition-colors duration-200">{link.label}</a></li>
          ))}
        </ul>
      </div>

      <div>
        <h4 class="text-white font-bold text-sm tracking-widest mb-5 uppercase">Kontak</h4>
        <ul class="space-y-4">
          <li>
            <a href="https://wa.me/6281318679190" class="flex items-center gap-3 text-gray-500 hover:text-white text-sm transition-colors">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-wood-500 flex-shrink-0"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13.5a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 2.68h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
              0813-1867-9190
            </a>
          </li>
          <li>
            <a href="https://instagram.com/pintujatiminimalis" target="_blank" rel="noreferrer" class="flex items-center gap-3 text-gray-500 hover:text-white text-sm transition-colors">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-wood-500 flex-shrink-0"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
              @pintujatiminimalis
            </a>
          </li>
          <li class="flex items-start gap-3 text-gray-500 text-sm">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-wood-500 flex-shrink-0 mt-0.5"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
            <span>Perumahan Botanical Kartasura,<br />Boyolali, Jawa Tengah</span>
          </li>
        </ul>
      </div>
    </div>

    <div class="border-t border-white/5 pt-6 flex flex-col sm:flex-row items-center justify-between gap-3">
      <p class="text-gray-600 text-xs">© {year} Pintu Jati Minimalis. All rights reserved.</p>
      <p class="text-gray-700 text-xs">Spesialis Pintu Kayu Jati — Boyolali, Jawa Tengah</p>
    </div>
  </div>
