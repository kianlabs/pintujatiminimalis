---
const year = new Date().getFullYear()
const quickLinks = [
  { label: 'Beranda', href: '#beranda' },
  { label: 'Keunggulan', href: '#tentang' },
  { label: 'Video', href: '#video' },
  { label: 'Cara Pesan', href: '#proses' },
  { label: 'Kontak', href: '#kontak' },
]
---

<footer class="bg-surface-900 border-t border-surface-600">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-16 pb-8">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-12 mb-12">

      <!-- Brand -->
      <div class="md:col-span-1">
        <div class="flex items-center gap-3 mb-4">
          <img src="/logo.jpg" alt="Pintu Jati Minimalis" class="w-10 h-10 rounded-lg object-cover" />
          <div>
            <div class="text-white font-bold text-lg leading-none">PINTU JATI MINIMALIS</div>
            <div class="text-primary-400 text-xs leading-none mt-0.5">Jati Perhutani Asli</div>
          </div>
        </div>
        <p class="text-gray-400 text-sm leading-relaxed mb-6">
          Spesialis pembuatan pintu kayu jati asli Perhutani di Boyolali. Bersertifikat, kokoh, dan tahan lama untuk hunian impian Anda.
        </p>
        <p class="text-gray-500 text-xs mb-3 tracking-widest uppercase">Ikuti Kami</p>
        <div class="flex gap-3">
          <a href="https://www.instagram.com/pintu_jati_minimalis" target="_blank" rel="noreferrer"
            class="inline-flex items-center gap-2 bg-surface-700 hover:bg-primary-500/20 border border-surface-600 hover:border-primary-500 text-gray-400 hover:text-white text-sm font-medium px-4 py-2.5 rounded-full transition-all duration-200">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="flex-shrink-0"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
            Instagram
          </a>
          <a href="https://www.tiktok.com/@ud.dwibarokahjati" target="_blank" rel="noreferrer"
            class="inline-flex items-center gap-2 bg-surface-700 hover:bg-primary-500/20 border border-surface-600 hover:border-primary-500 text-gray-400 hover:text-white text-sm font-medium px-4 py-2.5 rounded-full transition-all duration-200">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" class="flex-shrink-0"><path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-2.88 2.5 2.89 2.89 0 0 1-2.89-2.89 2.89 2.89 0 0 1 2.89-2.89c.28 0 .54.04.79.1V9.01a6.33 6.33 0 0 0-.79-.05 6.34 6.34 0 0 0-6.34 6.34 6.34 6.34 0 0 0 6.34 6.34 6.34 6.34 0 0 0 6.33-6.34V8.69a8.18 8.18 0 0 0 4.78 1.52V6.75a4.85 4.85 0 0 1-1.01-.06z"/></svg>
            TikTok
          </a>
        </div>
      </div>

      <!-- Quick links -->
      <div>
        <h4 class="text-white font-bold text-sm tracking-widest mb-5 uppercase">Menu</h4>
        <ul class="space-y-3">
          {quickLinks.map(link => (
            <li><a href={link.href} class="text-gray-400 hover:text-primary-400 text-sm transition-colors duration-200">{link.label}</a></li>
          ))}
        </ul>
      </div>

      <!-- Contact -->
      <div>
        <h4 class="text-white font-bold text-sm tracking-widest mb-5 uppercase">Kontak</h4>
        <ul class="space-y-4">
          <li>
            <a href="https://wa.me/6281548315366?text=Halo%2C%20saya%20ingin%20konsultasi%20mengenai%20pintu%20jati%20minimalis" target="_blank" rel="noreferrer" class="flex items-center gap-3 text-gray-400 hover:text-white text-sm transition-colors">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-primary-400 flex-shrink-0"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13.5a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 2.68h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
              0815-4831-5366 (Dwi Toto)
            </a>
          </li>
          <li>
            <a href="https://wa.me/6285863413670?text=Halo%2C%20saya%20ingin%20konsultasi%20mengenai%20pintu%20jati%20minimalis" target="_blank" rel="noreferrer" class="flex items-center gap-3 text-gray-400 hover:text-white text-sm transition-colors">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-primary-400 flex-shrink-0"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13.5a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 2.68h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
              0858-6341-3670 (Ferdi)
            </a>
          </li>
          <li>
            <a href="https://instagram.com/pintu_jati_minimalis" target="_blank" rel="noreferrer" class="flex items-center gap-3 text-gray-400 hover:text-white text-sm transition-colors">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-primary-400 flex-shrink-0"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
              @pintu_jati_minimalis
            </a>
          </li>
          <li class="flex items-start gap-3 text-gray-400 text-sm">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-primary-400 flex-shrink-0 mt-0.5"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
            <span>Boyolali, Jawa Tengah</span>
          </li>
        </ul>
      </div>

    </div>

    <div class="border-t border-surface-600 pt-6 flex flex-col sm:flex-row items-center justify-between gap-3">
      <p class="text-gray-500 text-xs">© {year} Pintu Jati Minimalis. All rights reserved.</p>
      <p class="text-gray-600 text-xs">Jati Perhutani Asli — Boyolali, Jawa Tengah</p>
    </div>
  </div>
</footer>
