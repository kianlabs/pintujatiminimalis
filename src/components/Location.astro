<section id="kontak" class="py-12 sm:py-24 bg-surface-800">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-2xl mx-auto">
      <div id="location-left">
        <span class="text-primary-400 text-xs font-bold uppercase tracking-[0.2em] mb-3 block">Lokasi Kami</span>
        <h2 class="text-4xl lg:text-5xl font-black text-white mb-4">
          Pesan Pintu<br />
          <span class="text-primary-300">Langsung ke Kami</span>
        </h2>
        <p class="text-gray-400 text-lg mb-8">
          Kunjungi workshop kami atau hubungi via WhatsApp untuk konsultasi pintu langsung tanpa biaya.
        </p>

        <div class="space-y-5 mb-8">
          {[
            { icon: 'M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0zM12 10m-3 0a3 3 0 1 0 6 0a3 3 0 1 0-6 0', label: 'Alamat Workshop', value: 'Boyolali, Jawa Tengah', isLink: false },
            { icon: 'M12 2a10 10 0 1 0 0 20A10 10 0 0 0 12 2zm0 0v10l4 2', label: 'Jam Operasional', value: 'Buka Setiap Hari\n08.00 – 17.00 WIB', isLink: false },
            { icon: 'M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13.5a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 2.68h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z', label: 'Telepon / WA', value: '0815-4831-5366 (Dwi Toto)\n0858-6341-3670 (Ferdi)', isLink: false },
            { icon: 'M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2zM22 6l-10 7L2 6', label: 'Instagram', value: '@pintu_jati_minimalis', isLink: true, href: 'https://instagram.com/pintu_jati_minimalis' },
          ].map(({ icon, label, value, isLink, href }) => (
            <div class="flex items-start gap-4">
              <div class="w-10 h-10 rounded-xl bg-primary-500/20 border border-primary-500/30 flex items-center justify-center flex-shrink-0">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-primary-400"><path d={icon}/></svg>
              </div>
              <div>
                <div class="text-white font-semibold mb-0.5">{label}</div>
                {isLink
                  ? <a href={href} target="_blank" rel="noreferrer" class="text-primary-400 hover:text-primary-300 text-sm font-medium transition-colors">{value}</a>
                  : <div class="text-gray-400 text-sm whitespace-pre-line">{value}</div>
                }
              </div>
            </div>
          ))}
        </div>

        <div class="flex flex-wrap gap-3">
          <a href="https://wa.me/6281548315366?text=Halo%2C%20saya%20ingin%20konsultasi%20mengenai%20pintu%20jati%20minimalis" target="_blank" rel="noreferrer"
