---
---

<section id="kontak" class="py-12 sm:py-24 bg-surface-800">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-2xl mx-auto">
      <div id="location-left">
        <span data-i18n="loc_label" class="text-primary-400 text-xs font-bold uppercase tracking-[0.2em] mb-3 block">Lokasi Kami</span>
        <h2 class="text-4xl lg:text-5xl font-black text-white mb-4">
          <span data-i18n="loc_title_1">Pesan Pintu,</span><br />
          <span class="text-primary-300" data-i18n="loc_title_2">Langsung ke Kami</span>
        </h2>
        <p data-i18n="loc_subtitle" class="text-gray-400 text-lg mb-8">
          Kunjungi workshop kami atau hubungi via WhatsApp untuk konsultasi pintu langsung tanpa biaya.
        </p>

        <div class="space-y-5 mb-8">
          <!-- Alamat -->
          <div class="flex items-start gap-4">
            <div class="w-10 h-10 rounded-xl bg-primary-500/20 border border-primary-500/30 flex items-center justify-center flex-shrink-0">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-primary-400" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0zM12 10m-3 0a3 3 0 1 0 6 0a3 3 0 1 0-6 0"/></svg>
            </div>
            <div>
              <div data-i18n="loc_address_label" class="text-white font-semibold mb-0.5">Alamat Workshop</div>
              <div data-i18n="loc_address_val" class="text-gray-400 text-sm">Boyolali, Jawa Tengah</div>
            </div>
          </div>
          <!-- Jam -->
          <div class="flex items-start gap-4">
            <div class="w-10 h-10 rounded-xl bg-primary-500/20 border border-primary-500/30 flex items-center justify-center flex-shrink-0">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-primary-400" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            </div>
            <div>
              <div data-i18n="loc_hours_label" class="text-white font-semibold mb-0.5">Jam Operasional</div>
              <!-- Use data-i18n only; JS applyTranslations sets textContent with \n handled by whitespace-pre-line -->
              <div data-i18n="loc_hours_val" class="text-gray-400 text-sm whitespace-pre-line">Buka Setiap Hari
08.00 – 17.00 WIB</div>
            </div>
          </div>
          <!-- Telepon -->
          <div class="flex items-start gap-4">
            <div class="w-10 h-10 rounded-xl bg-primary-500/20 border border-primary-500/30 flex items-center justify-center flex-shrink-0">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-primary-400" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13.5a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 2.68h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            </div>
            <div>
              <div data-i18n="loc_phone_label" class="text-white font-semibold mb-0.5">Telepon / WA</div>
              <div class="text-gray-400 text-sm">0815-4831-5366 (Dwi Toto)<br />0858-6341-3670 (Ferdi)</div>
            </div>
          </div>
          <!-- Instagram -->
          <div class="flex items-start gap-4">
            <div class="w-10 h-10 rounded-xl bg-primary-500/20 border border-primary-500/30 flex items-center justify-center flex-shrink-0">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-primary-400" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
            </div>
            <div>
              <div data-i18n="loc_ig_label" class="text-white font-semibold mb-0.5">Instagram</div>
              <a href="https://instagram.com/pintu_jati_minimalis" target="_blank" rel="noreferrer" class="text-primary-400 hover:text-primary-300 text-sm font-medium transition-colors">@pintu_jati_minimalis</a>
            </div>
          </div>
        </div>

        <div class="flex flex-wrap gap-3">
          <a href="https://wa.me/6281548315366?text=Halo%2C%20saya%20ingin%20konsultasi%20mengenai%20pintu%20jati%20minimalis" target="_blank" rel="noreferrer"
            class="inline-flex items-center gap-2.5 bg-green-wa hover:bg-green-wa-dark text-white font-bold px-7 py-4 rounded-full shadow-lg transition-all duration-300 hover:-translate-y-0.5">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            <span data-i18n="loc_cta_dwi">Chat Dwi Toto</span>
          </a>
          <a href="https://wa.me/6285863413670?text=Halo%2C%20saya%20ingin%20konsultasi%20mengenai%20pintu%20jati%20minimalis" target="_blank" rel="noreferrer"
            class="inline-flex items-center gap-2.5 bg-green-wa hover:bg-green-wa-dark text-white font-bold px-7 py-4 rounded-full shadow-lg transition-all duration-300 hover:-translate-y-0.5">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            <span data-i18n="loc_cta_ferdi">Chat Ferdi</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap'
  import { ScrollTrigger } from 'gsap/ScrollTrigger'
  gsap.registerPlugin(ScrollTrigger)
  gsap.fromTo('#location-left', { opacity: 0, x: -50 }, { opacity: 1, x: 0, duration: 0.9, ease: 'power3.out', scrollTrigger: { trigger: '#kontak', start: 'top 80%' } })
</script>
