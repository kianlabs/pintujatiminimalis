---
import '../styles/global.css'
import { translations } from '../i18n/translations'
import type { Lang } from '../i18n/translations'

interface Props {
  lang?: Lang
  title?: string
  description?: string
  canonical?: string
}

const site = Astro.site ? String(Astro.site).replace(/\/+$/, '') : 'https://pintujatiminimalis-astro.vercel.app'
const base = site
const md = { id: base, en: base + '/en' }
const {
  lang = 'id',
  title = translations[lang].layout_title,
  description = translations[lang].layout_desc,
  canonical = md[lang],
} = Astro.props
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#0e151b" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="id" href={base} />
    <link rel="alternate" hreflang="en" href={base + '/en'} />
    <link rel="alternate" hreflang="x-default" href={base} />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={base + '/og-image.jpg'} />
    <meta property="og:locale" content={lang === 'en' ? 'en_US' : 'id_ID'} />
    <meta property="og:locale:alternate" content={lang === 'en' ? 'id_ID' : 'en_US'} />
    <meta property="og:site_name" content="Pintu Jati Minimalis" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={base + '/og-image.jpg'} />

    <!-- Structured Data: Local Business -->
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'LocalBusiness',
      'name': 'Pintu Jati Minimalis',
      'description': 'Spesialis pembuatan pintu kayu jati asli Perhutani di Boyolali, Jawa Tengah. Bersertifikat, kokoh, dan tahan lama.',
      'url': base,
      'telephone': '+6281548315366',
      'address': {
        '@type': 'PostalAddress',
        'streetAddress': 'Boyolali',
        'addressLocality': 'Boyolali',
        'addressRegion': 'Jawa Tengah',
        'addressCountry': 'ID'
      },
      'openingHours': 'Mo-Su 08:00-17:00',
      'sameAs': [
        'https://www.instagram.com/pintu_jati_minimalis',
        'https://www.tiktok.com/@ud.dwibarokahjati',
        'https://wa.me/6281548315366'
      ],
      'priceRange': '$$',
      'image': base + '/og-image.jpg'
    })}>
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" href="/hero-bg.jpg" as="image" />
    <link rel="preload" href="/logo.jpg" as="image" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet" />

    <title>{title}</title>

    <!-- Sync lang attribute before first paint to avoid flash -->
    <script is:inline>
      ;(function () {
        try {
          var stored = localStorage.getItem('lang')
          if (stored === 'en' || stored === 'id') document.documentElement.lang = stored
        } catch (e) {}
      })()
    </script>
  </head>
  <body>
    <slot />
    <script>
      import { applyTranslations, getLang } from '../i18n/i18n'
      const lang = getLang()
      document.documentElement.lang = lang
      applyTranslations(lang)
    </script>
  </body>
</html>
