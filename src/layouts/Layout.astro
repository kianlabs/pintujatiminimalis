---
import '../styles/global.css'

interface Props {
  title?: string
  description?: string
  canonical?: string
}

const {
  title = 'Pintu Jati Minimalis – Spesialis Pintu Kayu Jati Perhutani Berkualitas Tinggi',
  description = 'Pintu Jati Minimalis, spesialis pembuatan pintu kayu jati asli Perhutani di Boyolali. Bersertifikat, kokoh, tahan lama. Konsultasi gratis via WhatsApp.',
  canonical = 'https://pintujatiminimalis.my.id',
} = Astro.props
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#0e151b" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://pintujatiminimalis.my.id/og-image.jpg" />
    <meta property="og:locale" content="id_ID" />
    <meta property="og:locale:alternate" content="en_US" />
    <meta property="og:site_name" content="Pintu Jati Minimalis" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://pintujatiminimalis.my.id/og-image.jpg" />

    <!-- Structured Data: Local Business -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "LocalBusiness",
        "name": "Pintu Jati Minimalis",
        "description": "Spesialis pembuatan pintu kayu jati asli Perhutani di Boyolali, Jawa Tengah. Bersertifikat, kokoh, dan tahan lama.",
        "url": "https://pintujatiminimalis.my.id",
        "telephone": "+6281548315366",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "Boyolali",
          "addressLocality": "Boyolali",
          "addressRegion": "Jawa Tengah",
          "addressCountry": "ID"
        },
        "openingHours": "Mo-Su 08:00-17:00",
        "sameAs": [
          "https://www.instagram.com/pintu_jati_minimalis",
          "https://www.tiktok.com/@ud.dwibarokahjati",
          "https://wa.me/6281548315366"
        ],
        "priceRange": "$$",
        "image": "https://pintujatiminimalis.my.id/og-image.jpg"
      }
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" href="/hero-bg.jpg" as="image" />
    <link rel="preload" href="/logo.jpg" as="image" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet" />

    <title>{title}</title>

    <!-- Sync lang attribute before first paint to avoid flash -->
    <script is:inline>
      ;(function () {
        var lang = localStorage.getItem('lang')
        if (lang === 'en') document.documentElement.lang = 'en'
      })()
    </script>
  </head>
  <body>
    <slot />
    <script>
      import { applyTranslations, getLang } from '../i18n/i18n'
      applyTranslations(getLang())
    </script>
  </body>
</html>
